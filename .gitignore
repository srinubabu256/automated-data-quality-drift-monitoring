# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# SQLite Databases & temp databases
*.db
*.db-*
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Test & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Processing runtime outputs (preserve gitkeep)
data/input/*
!data/input/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/rejected/*
!data/rejected/.gitkeep
reports/*
!reports/.gitkeep
!reports/performance_report.md
!reports/performance_report.json

