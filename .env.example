# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (Defaults to local SQLite)
# For SQLite: sqlite:///./data/yottaflex.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/yottaflex_db
DATABASE_URL=sqlite:///./data/yottaflex.db

# Storage Directories
DATA_INPUT_DIR=./data/input
DATA_PROCESSED_DIR=./data/processed
DATA_REJECTED_DIR=./data/rejected
DATA_SAMPLE_DIR=./data/sample
REPORTS_DIR=./reports

# Profiling & Alerting Thresholds
BASELINE_VERSION=v1.0
ALERT_VOLUME_DROP_PCT=30.0
ALERT_NULL_RATE_INCREASE_PCT=10.0
ALERT_AMOUNT_DRIFT_PCT=50.0
ALERT_REJECTION_RATE_MAX_PCT=5.0

